# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# KÉPEK: csak az kerül a verziókezelőbe, amit az oldal tényleg megjelenít.
# Minden más az átadott anyag része, és ezen a gépen marad.
#
#   forras/kepek/        az ügyfél 121 nyers fotója (110 MB) → public/galeria/
#   forras/*.jpg|png     az átadott plakátok, táblázat, árlista → public/plakat/
#   forras/nem-hasznalt/ ami legyártás után sem került egyetlen oldalra sem
/forras/kepek/
/forras/*.jpg
/forras/*.png
/forras/nem-hasznalt/
